# ══════════════════════════════════════════════════════════
# SCOOTMART.AE — ENVIRONMENT VARIABLES
# 1. Copy this file to .env.local for local dev
# 2. Fill in all values (see setup instructions below)
# 3. Add ALL values to Vercel Dashboard → Settings → Environment Variables
# ══════════════════════════════════════════════════════════

# ── SITE ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://scootmart-marketplace.vercel.app
NEXT_PUBLIC_APP_NAME=ScootMart.ae

# ── SUPABASE (database + auth) ─────────────────────────────
# Get keys: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key (server-side ONLY — never expose to client):
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── GROQ AI (ScootBot chatbot) ─────────────────────────────
# Get your key: console.groq.com → API Keys → Create
GROQ_API_KEY=gsk_...

# ── STRIPE (payments + escrow) ─────────────────────────────
# Get keys: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook secret: dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── RESEND (transactional email) ───────────────────────────
# Get key: resend.com → API Keys → Create
RESEND_API_KEY=re_...
# The "from" address (must be a verified domain in Resend)
EMAIL_FROM=ScootMart.ae <noreply@scootmart.ae>
VENDOR_NOTIFICATION_EMAIL=hello@scootmart.ae

# ── GOOGLE ANALYTICS ───────────────────────────────────────
# Get from: analytics.google.com → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── CRON SECURITY ──────────────────────────────────────────
# Generate: openssl rand -base64 32
# Add to Vercel AND paste in Vercel Cron auth header
CRON_SECRET=your_random_secret_here

# ── ESCROW CONFIG ──────────────────────────────────────────
ESCROW_HOLD_DAYS=7

# ══════════════════════════════════════════════════════════
# SETUP CHECKLIST — do these in order
# ══════════════════════════════════════════════════════════
#
# 1. SUPABASE
#    → supabase.com → New project
#    → Settings → API → copy URL, anon key, service role key
#    → SQL Editor → paste supabase/migrations/001_initial_schema.sql → Run
#    → SQL Editor → paste supabase/migrations/002_indices_and_constraints.sql → Run
#    → Authentication → Providers → enable Google, Facebook (add keys from their consoles)
#
# 2. GROQ (free AI chatbot)
#    → console.groq.com → Sign up free
#    → API Keys → Create → copy → GROQ_API_KEY
#
# 3. STRIPE
#    → dashboard.stripe.com → Developers → API keys
#    → Copy Secret key → STRIPE_SECRET_KEY
#    → Copy Publishable key → NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#    → Developers → Webhooks → Add endpoint:
#      URL: https://scootmart-marketplace.vercel.app/api/stripe/webhook
#      Events: checkout.session.completed, payment_intent.payment_failed,
#              charge.dispute.created, charge.refunded
#    → Copy Signing secret → STRIPE_WEBHOOK_SECRET
#
# 4. RESEND (email)
#    → resend.com → Sign up free (3,000 emails/month)
#    → API Keys → Create → RESEND_API_KEY
#    → Domains → Add scootmart.ae → verify DNS records
#    → Set EMAIL_FROM to noreply@scootmart.ae (after domain verified)
#    → Until domain verified, use: onboarding@resend.dev
#
# 5. GOOGLE ANALYTICS
#    → analytics.google.com → Create account → Web stream
#    → Copy Measurement ID (G-XXXXXXXXXX) → NEXT_PUBLIC_GA_MEASUREMENT_ID
#
# 6. VERCEL
#    → vercel.com → your project → Settings → Environment Variables
#    → Add ALL variables above
#    → Add NEXT_PUBLIC_APP_URL=https://scootmart-marketplace.vercel.app
#    → Redeploy after adding variables
#    → Cron jobs (escrow auto-release) run automatically from vercel.json
# ══════════════════════════════════════════════════════════
